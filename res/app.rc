// ============================================================================
// 文件管理器（自研 Explorer 替代品）
// 文件：res/app.rc —— 资源脚本
//
// 作用：
//   1. 把 app.manifest 嵌入 exe（这是 ComCtl32 v6 生效的关键一步）
//   2. 写入版本信息（在资源管理器里右键 exe → 属性 → 详细信息 能看到）
//
// 注意：本文件刻意全部使用 ASCII 字符，不放中文。
//       原因是 rc.exe 对非 ASCII 源文件的编码处理依赖 BOM，容易出问题，
//       为了编译链路稳定，版本信息先用英文；需要中文时再单独处理编码。
// ============================================================================

#include <windows.h>
#include "resource.h"
#include "version.h"   // YEXP_VER_* : the only place version numbers live

// ----------------------------------------------------------------------------
// 1. 嵌入应用程序清单
//    CREATEPROCESS_MANIFEST_RESOURCE_ID (值 1) 是清单的标准资源 ID，
//    必须用 1，否则系统不会把它当作进程清单加载。
// ----------------------------------------------------------------------------
1 RT_MANIFEST "app.manifest"

// ----------------------------------------------------------------------------
// 3. 程序图标
//    exe 自己的图标（资源管理器里看文件、任务栏、快捷方式都用它），
//    C++ 那边也用同一个 ID 给主窗口设置标题栏图标。
// ----------------------------------------------------------------------------
IDI_APPICON ICON "app.ico"

// ----------------------------------------------------------------------------
// 3. Embedded explorer.exe thin proxy (RCDATA binary resource)
//
//    Why embed it:
//      The release package must be a single FileExplorer.exe, without an extra
//      explorer-proxy.exe (users tend to delete it, packagers tend to miss it).
//      The proxy binary is welded into the main program, and at deploy time it is
//      extracted with FindResource/LoadResource, written to a temp file, copied
//      into System32, and the temp file is deleted.
//
//    Payload file: res\explorer-proxy-x64.exe (copy of bin\launcher\x64\explorer.exe).
//                  After changing the proxy (Launcher.vcxproj), run
//                  tools\update-proxy-payload.ps1 to refresh the payload,
//                  then rebuild the main program.
//    The resource ID is shared with C++ via res\resource.h (IDR_EXPLORER_PROXY).
// ----------------------------------------------------------------------------
IDR_EXPLORER_PROXY RCDATA "explorer-proxy-x64.exe"

// ----------------------------------------------------------------------------
// 2. 版本信息
// ----------------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     YEXP_VER_MAJOR,YEXP_VER_MINOR,YEXP_VER_PATCH,YEXP_VER_BUILD
 PRODUCTVERSION  YEXP_VER_MAJOR,YEXP_VER_MINOR,YEXP_VER_PATCH,YEXP_VER_BUILD
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 语言 0x0804 = 简体中文，代码页 1200 = Unicode
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "Personal Project"
            VALUE "FileDescription",  "File Explorer (custom implementation)"
            VALUE "FileVersion",      YEXP_VER_STRING
            VALUE "InternalName",     "FileExplorer"
            VALUE "OriginalFilename", "FileExplorer.exe"
            VALUE "ProductName",      "File Explorer"
            VALUE "ProductVersion",   YEXP_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
